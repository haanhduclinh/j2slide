{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "j2slide",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "DECK", "class_name": "DeckDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeckDO"] }],
  "observability": { "enabled": true }
}
